# Audio
SAMPLE_RATE=16000
CHUNK_DURATION_MS=500
VAD_THRESHOLD=0.5
VAD_MIN_SPEECH_DURATION_MS=250
VAD_MIN_SILENCE_DURATION_MS=100
VAD_SPEECH_PAD_MS=300

# STT
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# LLM - единые настройки для Ollama и LM Studio
# Провайдер: ollama или lmstudio
# Для Ollama (по умолчанию)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=ollama
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=60
LLM_MAX_TOKENS=256

# ИЛИ для LM Studio (закомментируйте Ollama и раскомментируйте это)
# LLM_PROVIDER=lmstudio
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_MODEL=qwen2.5-coder-7b-instruct
# LLM_API_KEY=lm-studio
# LLM_TEMPERATURE=0.7
# LLM_TIMEOUT=60
# LLM_MAX_TOKENS=256

# TTS
SILERO_LANGUAGE=ru
SILERO_SPEAKER=v5_ru
SILERO_VOICE=baya
SILERO_SAMPLE_RATE=48000

# Audio output device (None = system default, or device index from sounddevice)
# Run: python -c "import sounddevice as sd; print(sd.query_devices())"
OUTPUT_DEVICE=

# Memory
DB_PATH=data/voice_ai.db
HISTORY_LIMIT=50

# Activation mode: button (Enter) | wake_word (voice keyword) | continuous (any speech)
ACTIVATION_MODE=wake_word

# Wake word detection (Phase 2)
WAKE_WORD_MODEL=base
WAKE_WORD_DEVICE=cpu
WAKE_WORD_COMPUTE_TYPE=int8
WAKE_WORD_PHRASES=войс ай,voice ai,войсай,войс айай
WAKE_WORD_COOLDOWN_S=3.0
WAKE_WORD_MATCH_THRESHOLD=0.7

# RAG (Retrieval-Augmented Generation)
# Активируется автоматически, если в RAG_PDF_DIRECTORY есть PDF файлы
RAG_PDF_DIRECTORY=data/pdf
RAG_CHROMA_DIR=data/chroma_db
RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-large
RAG_EMBEDDING_DEVICE=cpu
RAG_CHUNK_SIZE=1024
RAG_CHUNK_OVERLAP=200
RAG_RETRIEVER_K=3
RAG_MAX_RETRIES=3
RAG_USE_WEB_SEARCH=true
RAG_LLM_TEMPERATURE=0.0

# Pipeline
LOG_LEVEL=INFO
